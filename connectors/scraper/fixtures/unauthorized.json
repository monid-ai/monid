            "res": {
                "status": 401,
                "body": {
                    "type": "https://api.scraper.run/errors/unauthorized",
                    "status": 401,
                    "code": "unauthorized",
                    "message": "Unauthorized",
                    "requestId": "req_daaf39e1f204463f7956b882",
                    "docUrl": "https://docs.scraper.run/errors/unauthorized",
                    "retryable": false
                }
            }
        }
    ]
}
