{
    "name": "synthetic-read-file",
    "description": "Read a file in an owned sandbox (live 2026-11-13 response).",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/api/v1/sandboxes/sbx-1/files?path=%2Ftmp%2Fhello.txt"
            },
            "res": {
                "status": 200,
                "body": {
                    "path": "/tmp/hello.txt",
                    "type": "file",
                    "content": "hi from monid"
                }
            }
        }
    ]
}
