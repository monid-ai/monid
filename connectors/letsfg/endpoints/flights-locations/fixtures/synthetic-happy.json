                        },
                        {
                            "iata": "LHR",
                            "name": "Heathrow",
                            "city": "London",
                            "country": "United Kingdom",
                            "type": "airport"
                        },
                        {
                            "iata": "LGW",
                            "name": "Gatwick",
                            "city": "London",
                            "country": "United Kingdom",
                            "type": "airport"
                        }
                    ]
                }
            }
        }
    ]
