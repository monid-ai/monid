{
    "name": "synthetic-document-transient",
    "description": "SYNTHETIC transient status lookup: the poll answers 429 RATE_LIMITED once (the document keeps being written), then done. The run holds open instead of settling on a failed lookup.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 202,
                "body": {
                    "id": "doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                    "status": "working",
                    "status_url": "https://api.worklittle.com/v1/documents/doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                    "poll_after_seconds": 5,
                    "billing": {
                        "charged_usd": 0,
                        "note": "Charged when the document is ready; failures are free."
                    }
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v1/documents/doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "res": {
                "status": 429,
                "body": {
                    "error": {
                        "code": "RATE_LIMITED",
                        "message": "Too many requests"
                    }
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v1/documents/doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "res": {
                "status": 200,
                "body": {
                    "id": "doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                    "status": "done",
                    "document_type": "resume",
                    "mode": "ready",
                    "formats": [
                        "html",
                        "pdf"
                    ],
                    "html": "<article><h1>Jordan Rivera</h1><p>Senior Product Manager</p></article>",
                    "pdf_base64": "JVBERi0xLjcKJSDigJMgc3ludGhldGljCg==",
                    "pdf_mime": "application/pdf",
                    "pdf_filename": "jordan-rivera-resume.pdf",
                    "docx_base64": null,
                    "docx_mime": null,
                    "docx_filename": null,
                    "billing": {
                        "charged_usd": 0.01,
                        "balance_after_usd": 41.27,
                        "already_charged": false
                    }
                }
            }
        }
    ]
}
