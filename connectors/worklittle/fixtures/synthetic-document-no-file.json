{
    "name": "synthetic-document-no-file",
    "description": "SYNTHETIC done job carrying no html/pdf/docx: not a document, so the lifecycle settles it as a 502 provider error with zero usage.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 202,
                "body": {
                    "id": "doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                    "status": "working",
                    "status_url": "https://api.worklittle.com/v1/documents/doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                    "poll_after_seconds": 5,
                    "billing": {
                        "charged_usd": 0,
                        "note": "Charged when the document is ready; failures are free."
                    }
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v1/documents/doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "res": {
                "status": 200,
                "body": {
                    "id": "doc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                    "status": "done",
                    "document_type": "resume",
                    "mode": "ready",
                    "formats": [
                        "html",
                        "pdf"
                    ],
                    "html": null,
                    "pdf_base64": null,
                    "billing": {
                        "charged_usd": 0
                    }
                }
            }
        }
    ]
}
