{
    "name": "recorded-options-png-selector",
    "description": "Real bounded Scrapeless option probe, 2026-10-23. Minimal redacted chain; small image/structured strings retained intact for signature and JSON assertions. Full evidence in research/live-options-2026-10-23. Test billing is fictional, never actual charges.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "https://api.scrapeless.com/api/v2/unlocker/request",
                "body": {
                    "actor": "unlocker.webunlocker",
                    "input": {
                        "url": "https://httpbin.org/html",
                        "jsRender": {
                            "enabled": true,
                            "waitUntil": "domcontentloaded",
                            "instructions": [
                                {
                                    "evaluate": "document.body.innerHTML='<h1 style=\"background:white;color:black;width:220px;height:40px\">MONID_IMAGE_OK</h1>'"
                                }
                            ],
                            "response": {
                                "type": "png",
                                "options": {
                                    "selector": "h1",
                                    "fullPage": false
                                }
                            }
                        }
                    }
                }
            },
            "res": {
                "status": 200,
                "body": {
                    "code": 200,
                    "data": ""
                }
            }
        }
    ]
}
