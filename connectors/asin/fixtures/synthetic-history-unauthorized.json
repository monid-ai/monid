{
    "name": "synthetic-history-unauthorized",
    "description": "SYNTHETIC 401 for asin#history: Asin's error envelope for a missing or invalid key, as the API returns it.",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "https://www.asin.dev/api/v1/history?asin=B0CZY1LRT4&marketplace=com"
            },
            "res": {
                "status": 401,
                "body": {
                    "error": {
                        "code": "unauthorized",
                        "message": "Missing or invalid API key."
                    }
                }
            }
        }
    ]
}
