            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 200,
                "body": {
                    "object": "entity_search_task",
                    "leads_search_id": "leads_search_01JEXAMPLE000000000000",
                    "entity_type": "company",
                    "objective": "AI startups that raised Series A in 2024",
                    "limit": 3,
                    "status": "created",
                    "created_at": "2026-10-16T00:00:00Z"
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v1/entity-search/status?leads_search_id=leads_search_01JEXAMPLE000000000000"
            },
            "res": {
                "status": 503,
                "body": {
                    "object": "error",
                    "error": {
                        "type": "service_unavailable",
                        "message": "Entity Search is temporarily unavailable",
                        "param": null,
                        "request_id": null
                    }
                }
            }
        }
    ]
