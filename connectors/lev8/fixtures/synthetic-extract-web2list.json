{
    "name": "synthetic-extract-web2list",
    "description": "SYNTHETIC (no Lev8 key was available on 2026-10-16): shape from docs.lev8.com/openapi.yaml and Lev8's response structs; values are placeholders. Replace via `deno task record` when LEV8_API_KEY exists. Extract web2list success: a flat 80 credits regardless of row count.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 200,
                "body": {
                    "success": true,
                    "data": [
                        {
                            "name": "Example Person",
                            "company": "Example Co"
                        }
                    ],
                    "metadata": {
                        "type": "web2list",
                        "target": "https://www.forbes.com/30-under-30/2026/ai",
                        "instruction": "Extract name and company",
                        "limit": 100
                    }
                }
            }
        }
    ]
}
