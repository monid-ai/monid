{
    "name": "synthetic-verify-ok",
    "description": "Synthetic successful non-match. A completed verification is billed even when verified is false; no real biometric input.",
    "calls": [
        {
            "req": { "method": "POST", "url": "{{request.url}}" },
            "res": {
                "status": 200,
                "body": {
                    "verified": false,
                    "distance": 0.8,
                    "threshold": 0.4,
                    "model": "Facenet"
                }
            }
        }
    ]
}
