{
    "name": "sitemap-ok",
    "description": "Search1API /sitemap happy path: link inventory for s1.dev. Flat 1 credit.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}",
                "body": {
                    "url": "https://s1.dev",
                    "type": "sitemap"
                }
            },
            "res": {
                "status": 200,
                "body": {
                    "links": [
                        "https://s1.dev/",
                        "https://s1.dev/about"
                    ]
                }
            }
        }
    ]
}
