{
    "name": "synthetic-profile-verify-gone",
    "description": "verify on a deleted profile: 404 means inactive.",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/api/v1/profiles/aaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "res": {
                "status": 404,
                "body": {
                    "error": "Profile not found"
                }
            }
        }
    ]
}
