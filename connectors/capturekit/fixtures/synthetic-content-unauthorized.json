{
    "name": "synthetic-content-unauthorized",
    "description": "SYNTHETIC 401 for capturekit#v1/content: CaptureKit's error envelope for a missing or invalid key, as the API returns it.",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "https://api.capturekit.dev/v1/content?url=https%3A%2F%2Fexample.com&include_markdown=true"
            },
            "res": {
                "status": 401,
                "body": {
                    "error": "Invalid API Key"
                }
            }
        }
    ]
}
