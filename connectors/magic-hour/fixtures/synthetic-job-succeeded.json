{
    "name": "synthetic-job-succeeded",
    "description": "Submit an AI GIF, poll once while rendering, then return a completed project with a download and 50 credits charged.",
    "calls": [
        {
            "req": { "method": "POST", "url": "{{request.url}}" },
            "res": {
                "status": 200,
                "body": { "id": "project_1", "status": "queued" }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v1/image-projects/project_1"
            },
            "res": {
                "status": 200,
                "body": {
                    "id": "project_1",
                    "status": "rendering",
                    "downloads": []
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v1/image-projects/project_1"
            },
            "res": {
                "status": 200,
                "body": {
                    "id": "project_1",
                    "status": "complete",
                    "credits_charged": 50,
                    "downloads": [
                        { "url": "https://example.com/animation.gif" }
                    ]
                }
            }
        }
    ]
}
