{
    "name": "synthetic-draft-send-replay",
    "description": "The same saved draft revision yields the same durable sending state on retry.",
    "calls": [{
        "req": {
            "method": "POST",
            "url": "{{request.origin}}/api/v1/mailbox/drafts/draft_1/send?mailbox_id=mbx_owned",
            "body": { "expected_revision": 2 }
        },
        "res": {
            "status": 200,
            "body": {
                "ok": true,
                "data": { "id": "draft_1", "revision": 2, "status": "sending" }
            }
        }
    }]
}
