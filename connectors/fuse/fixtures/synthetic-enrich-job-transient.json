{
    "name": "synthetic-enrich-job-transient",
    "description": "A job whose reads fail twice while it keeps running (429 with Retry-After 2, then 503), then read completed with nothing found and a zero receipt. Synthetic, shaped on Fuse's published Business API contract (2026-10-29).",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 202,
                "body": {
                    "jobId": "6a1f2c3d4e5f6a7b8c9d0e1f",
                    "status": "pending"
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.url}}/6a1f2c3d4e5f6a7b8c9d0e1f"
            },
            "res": {
                "status": 429,
                "headers": {
                    "retry-after": "2"
                },
                "body": {
                    "error": {
                        "code": "RATE_LIMITED",
                        "message": "You have exceeded the rate limit. Please retry after the window resets.",
                        "param": null,
                        "doc_url": "https://docs.fuseai.com/concepts/errors#rate_limited",
                        "request_id": "11111111-1111-4111-8111-111111111111"
                    }
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.url}}/6a1f2c3d4e5f6a7b8c9d0e1f"
            },
            "res": {
                "status": 503,
                "body": {
                    "error": {
                        "code": "UNEXPECTED_ERROR",
                        "message": "An unexpected error occurred. Please try again later.",
                        "param": null,
                        "doc_url": "https://docs.fuseai.com/concepts/errors#unexpected_error",
                        "request_id": "11111111-1111-4111-8111-111111111111"
                    }
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.url}}/6a1f2c3d4e5f6a7b8c9d0e1f"
            },
            "res": {
                "status": 200,
                "body": {
                    "jobId": "6a1f2c3d4e5f6a7b8c9d0e1f",
                    "status": "completed",
                    "total": 1,
                    "processed": 1,
                    "found": 0,
                    "creditsCharged": 0,
                    "rows": [
                        {
                            "index": 0,
                            "status": "not_found",
                            "email": null,
                            "phone": null,
                            "linkedinUrl": null,
                            "creditsCharged": 0
                        }
                    ],
                    "stoppedReason": null
                }
            }
        }
    ]
}
