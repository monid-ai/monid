{
    "name": "synthetic-rate-limited-get",
    "description": "The same 429 RATE_LIMITED refusal on a GET, for the two filter-value endpoints. Synthetic, shaped on Fuse's published Business API contract (2026-10-29).",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 429,
                "headers": {
                    "retry-after": "30"
                },
                "body": {
                    "error": {
                        "code": "RATE_LIMITED",
                        "message": "You have exceeded the rate limit. Please retry after the window resets.",
                        "param": null,
                        "doc_url": "https://docs.fuseai.com/concepts/errors#rate_limited",
                        "request_id": "11111111-1111-4111-8111-111111111111"
                    }
                }
            }
        }
    ]
}
