                    "video_output": null,
                    "failed_reason": null,
                    "progress": 0.0
                }
            }
        },
        {
            "req": { "method": "GET", "url": "{{request.url}}JOB1/" },
            "res": {
                "status": 200,
                "body": {
                    "id": "JOB1",
                    "status": "rejected",
                    "failed_reason": "Generation rejected: content policy",
                    "video_output": null,
                    "credits_used": 0,
                    "duration": 5.0,
                    "progress": 0.0
                }
            }
        }
    ]
