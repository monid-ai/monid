{
    "name": "synthetic-job-failed",
    "description": "SYNTHETIC — a render that reaches `failed`: Creatify refunds the charge (credits_used reads 0 again) and names the cause in failed_reason. The run must settle as a provider error (synthesized 500 over a 200 poll) with zero usage. One chain serves every endpoint: the detail URL is the create URL plus the id.",
    "calls": [
        {
            "req": { "method": "POST", "url": "{{request.url}}" },
            "res": {
                "status": 201,
                "body": {
                    "id": "JOB1",
                    "status": "pending",
                    "credits_used": 0,
                    "video_output": null,
                    "failed_reason": null,
                    "progress": 0.0
                }
            }
        },
        {
            "req": { "method": "GET", "url": "{{request.url}}JOB1/" },
            "res": {
                "status": 200,
                "body": {
                    "id": "JOB1",
                    "status": "failed",
                    "failed_reason": "Generation failed, credits refunded",
                    "video_output": null,
                    "credits_used": 0,
                    "duration": 5.0,
                    "progress": 0.0
                }
            }
        }
    ]
}
