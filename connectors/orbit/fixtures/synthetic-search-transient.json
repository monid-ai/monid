{
    "name": "synthetic-search-transient",
    "description": "A status LOOKUP that fails while the search keeps running and keeps drawing credits. The 599 is deliberate: Orbit's error guide puts every temporary server failure in one retry class, so a proxy status outside the common four must be held exactly like a 503. The Retry-After header (seconds, as Orbit sends it) sets the next tick's cadence. The following tick reads the completed snapshot. Synthetic.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 202,
                "body": {
                    "search_id": "SEARCH5",
                    "request_id": "req-search5",
                    "status": "running",
                    "candidate_discovery": false,
                    "profile_depth": "partial",
                    "include_profile": false,
                    "profile_upgrades_completed": false,
                    "results": [],
                    "created_at": "2026-09-17T12:00:00.000Z",
                    "updated_at": "2026-09-17T12:01:00.000Z",
                    "links": {
                        "status": "/v3/search/SEARCH5"
                    }
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v3/search/SEARCH5"
            },
            "res": {
                "status": 599,
                "headers": {
                    "retry-after": "7"
                },
                "body": {
                    "status": "failed",
                    "error": {
                        "code": "upstream_unavailable",
                        "message": "Service unavailable"
                    }
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v3/search/SEARCH5"
            },
            "res": {
                "status": 200,
                "body": {
                    "search_id": "SEARCH5",
                    "request_id": "req-search5",
                    "status": "completed",
                    "candidate_discovery": false,
                    "profile_depth": "partial",
                    "include_profile": false,
                    "profile_upgrades_completed": true,
                    "results": [
                        {
                            "profile_id": "PROF_INDEXED_1",
                            "status": "ready",
                            "generation_level": 2,
                            "sources": [
                                "search"
                            ]
                        }
                    ],
                    "created_at": "2026-09-17T12:00:00.000Z",
                    "updated_at": "2026-09-17T12:01:00.000Z",
                    "links": {
                        "status": "/v3/search/SEARCH5"
                    }
                }
            }
        }
    ]
}
