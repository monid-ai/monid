{
    "name": "synthetic-search-papers",
    "description": "SYNTHETIC scholarly-paper preset for keenable#v1/search-papers. Shape matches synthetic-search-ok; snippet_max_length defaults to 10000 at the binding. Replay matches method+URL, not body.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}",
                "body": {
                    "query": "mixture of experts routing",
                    "site": "arxiv.org",
                    "snippet_max_length": 10000
                }
            },
            "res": {
                "status": 200,
                "body": {
                    "query": "mixture of experts routing",
                    "mode": "pro",
                    "results": [
                        {
                            "title": "Mixture-of-Experts Routing",
                            "url": "https://arxiv.org/abs/0000.00000",
                            "description": "",
                            "snippet": "Abstract and page extract returned with the paper URL in one search call.",
                            "published_at": "2026-03-01T00:00:00Z",
                            "acquired_at": "2026-03-02T00:00:00Z"
                        }
                    ]
                }
            }
        }
    ]
}
