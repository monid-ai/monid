{
    "name": "synthetic-pre-approved",
    "description": "SYNTHETIC — not recorded. The holder pre-approved this site and email: the login is created at once (HTTP 202, status approved).",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "https://api.agentvault.io/v1/logins/requests",
